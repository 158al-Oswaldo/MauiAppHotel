<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="10"
                             Spacing="10">

            <Label Text="Sobre"
                   FontFamily="Kalam"
                   FontSize="50"
                   TextColor="{StaticResource Primary}" />

            <Frame Padding="15">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding NomeApp}"
                           FontSize="Title"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding Versao, StringFormat='Versão {0}'}"
                           TextColor="{StaticResource Gray600}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="15">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      RowSpacing="10">

                    <Label Grid.Row="0" Grid.Column="0" Text="Desenvolvedor:" FontAttributes="Bold" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Desenvolvedor}"
                           TextColor="{StaticResource Primary}" />

                    <Label Grid.Row="1" Grid.Column="0" Text="Ano:" FontAttributes="Bold" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding AnoDesenvolvimento}"
                           TextColor="{StaticResource Primary}" />

                    <Label Grid.Row="2" Grid.Column="0" Text="Curso:" FontAttributes="Bold" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Curso}"
                           TextColor="{StaticResource Primary}" />

                    <Label Grid.Row="3" Grid.Column="0" Text="Componente:" FontAttributes="Bold" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Componente}"
                           TextColor="{StaticResource Primary}" />

                    <Label Grid.Row="4" Grid.Column="0" Text="Instituição:" FontAttributes="Bold" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding Instituicao}"
                           TextColor="{StaticResource Primary}" />

                    <Label Grid.Row="5" Grid.Column="0" Text="Tecnologia:" FontAttributes="Bold" />
                    <Label Grid.Row="5" Grid.Column="1" Text="{Binding Tecnologia}"
                           TextColor="{StaticResource Primary}" />
                </Grid>
            </Frame>

            <Label Text="{Binding AnoDesenvolvimento, StringFormat='© {0} - Todos os direitos reservados'}"
                   HorizontalOptions="Center"
                   FontSize="Micro"
                   TextColor="{StaticResource Gray600}" />

            <Button Text="Voltar"
                    Clicked="Voltar_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
